# Copy to backend/.env (gitignored) — never commit real secrets.
# Commercial IGDB use requires prior approval from partner@igdb.com.

# Required for homepage sections igdb-trending / igdb-popular (also discovery tools).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional — official Steam IStoreService/GetAppList (never paste into chat)
# STEAM_WEB_API_KEY=

# Scanner lists (VPS production — after IGDB commercial GO):
# IGDB_DISCOVERY_WRITE_PRODUCTION=1   # upsert Game stubs for resolved Steam AppIDs
# IGDB_DISCOVERY_ENQUEUE_SCANNERS=1   # tmp/igdb_scan_lists.json + scanner Tier-A priority
# IGDB_SCAN_LISTS_TOP_N=40
# IGDB_SCAN_LISTS_MAX_AGE_HOURS=8
# Optional homepage sections (off by default):
# IGDB_HOME_SECTIONS_ENABLED=0

# Local prototype safety defaults
IGDB_DISCOVERY_DRY_RUN=1
IGDB_DISCOVERY_LIMIT=50
IGDB_DISCOVERY_WRITE_PRODUCTION=0
IGDB_DISCOVERY_ENQUEUE_SCANNERS=0
