# Copy to backend/.env (gitignored) — never commit real secrets.
# Commercial IGDB use requires prior approval from partner@igdb.com.

# Required for homepage sections igdb-trending / igdb-popular (also discovery tools).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional — official Steam IStoreService/GetAppList (never paste into chat)
# STEAM_WEB_API_KEY=

# Prototype safety defaults
IGDB_DISCOVERY_DRY_RUN=1
IGDB_DISCOVERY_LIMIT=50
IGDB_DISCOVERY_WRITE_PRODUCTION=0
IGDB_DISCOVERY_ENQUEUE_SCANNERS=0
