# Partner product feeds (Awin) — Awin → Toolbox → Create-a-Feed
# https://productdata.awin.com/datafeed/list/apikey/YOUR_KEY
AWIN_DATAFEED_API_KEY=

# Awin advertiser IDs (join each program in Awin publisher account first)
AWIN_FEED_MERCHANT_G2A=11280
AWIN_FEED_MERCHANT_KINGUIN=32217
# Optional feed IDs (fid) from Toolbox → Create-a-Feed URL, if auto-catalog fails
# AWIN_FEED_FID_G2A=
# AWIN_FEED_FID_KINGUIN=
# Or paste full Create-a-Feed download URLs:
# AFFILIATE_FEED_URL_G2A=https://productdata.awin.com/datafeed/download/apikey/...
# CDKeys.com (Loaded) — join via Awin; merchant ID from your joined-programs list
AWIN_FEED_MERCHANT_CDKEYS=
# Gamivo is not on Awin — use AFFILIATE_FEED_URL_GAMIVO from Gamivo/Admitad panel
AWIN_FEED_MERCHANT_GAMIVO=
# Eneba regional programs on Awin (e.g. ES=19520, IT=19519); PL often uses direct Eneba feed URL
AWIN_FEED_MERCHANT_ENEBA=19520
# Fanatical Global — Awin merchant ID 118821
AWIN_FEED_MERCHANT_FANATICAL=118821
# Feed ID from Awin Toolbox (required if catalog shows joined:false)
AWIN_FEED_FID_FANATICAL=113374

# Direct feed URLs (XML/CSV gzip) when not using Awin merchant IDs
# AFFILIATE_FEED_URL_CDKEYS=https://...
# Gamivo direct feeds: PLN first, foreign currencies only as converted fallback
AFFILIATE_FEED_URLS_GAMIVO=https://www.gamivo.com/feed/pln/en/feed-cs-new.xml,https://www.gamivo.com/feed/eur/en/feed-cs-new.xml,https://www.gamivo.com/feed/usd/en/feed-cs-new.xml,https://www.gamivo.com/feed/gbp/en/feed-cs-new.xml,https://www.gamivo.com/feed/cad/en/feed-cs-new.xml
# AFFILIATE_FEED_URL_ENEBA=https://...

AFFILIATE_FEED_CACHE_HOURS=6
